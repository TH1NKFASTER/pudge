#!/usr/bin/env bash
set -u

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

PY="$ROOT/.venv-test/bin/python"

if [ ! -x "$PY" ]; then
  echo "❌ .venv-test is missing."
  echo "Run: python3.12 -m venv .venv-test && .venv-test/bin/python -m pip install -e '.[dev,sync]'"
  exit 1
fi

FAILED=0

for i in 0 1 2 3; do
  echo
  echo "=== Test batch $((i + 1))/4 ==="

  "$PY" scripts/run_test_batch.py --batch "$i" --batches 4

  [ $? -ne 0 ] && FAILED=1
done

if [ "$FAILED" -ne 0 ]; then
  echo "❌ Tests failed. Push cancelled."
  exit 1
fi

echo "✅ All tests passed."
